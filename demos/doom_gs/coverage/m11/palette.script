at +20t poke _g_player+117 40           # damagecount: the red tints
at +60t poke _g_player+119 10           # bonuscount: the gold tint
at +30t poke _g_player+47 200           # powers[pw_ironfeet]: green
at +60t poke _g_player+47 0
at +10t poke _g_player+43 1             # powers[pw_strength]: berserk
at +10t poke _g_player+117 20           #   with damage: red
at +60t poke _g_player+43 0
at +30t note end
stop
