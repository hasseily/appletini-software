{
 "format": "game-args 1",
 "about": "Part spawn's entries (docs/GAME.md 2.4 row spawn, 3.5 step 4; docs/game-parts/spawn.md). A mobj in A:X (upstream's _Dp[0-3] or AP); a spawn's x, y, z in GA_X, GA_Y, GA_Z; P_SpawnBlood's damage in GA_12 (GA_DMG); attackrange in sb:AT_RANGE (sp.inc's name of GM_ATRANGE in GW: request 1, wave 2 as integrated); shr3's operand and result in GA_0-3. Forms beyond gameroutine.py's, read by tools/native/gparts/spawn.py: the destination sb:NAME (a place of game/spawn/sp.inc), the sources cx (C:X: C the high word) and c (the carry), the native outputs c (the carry) and zp:NAME (bytes from the zero page).",
 "entries": {
  "p_spawn65.s:P_SpawnPuff": {
   "native": "P_SpawnPuff",
   "in": [{"from": "xc", "to": "zp:GA_X"},
          {"from": "dp:_Dp:4", "to": "zp:GA_Y"},
          {"from": "dp:_Dp+4:4", "to": "zp:GA_Z"},
          {"from": "abs:p_attack65.s:AT_RANGE:4", "to": "sb:AT_RANGE"}],
   "out": []},
  "p_spawn65.s:P_SpawnBlood": {
   "native": "P_SpawnBlood",
   "in": [{"from": "xc", "to": "zp:GA_X"},
          {"from": "dp:_Dp:4", "to": "zp:GA_Y"},
          {"from": "dp:_Dp+4:4", "to": "zp:GA_Z"},
          {"from": "s:4:2", "to": "zp:GA_12"}],
   "out": []},
  "p_attack65.s:P_IsAttackRangeMeleeRange": {
   "native": "P_IsAttackRangeMeleeRange",
   "in": [{"from": "abs:p_attack65.s:AT_RANGE:4", "to": "sb:AT_RANGE"}],
   "out": [{"native": "a", "upstream": "a", "bytes": 1}]},
  "p_mobj65.s:P_ZMovement": {
   "native": "P_ZMovement",
   "in": [{"from": "dp:_Dp:4", "to": "ax", "as": "mobj"}],
   "out": []},
  "p_mobj65.s:missileHit": {
   "native": "missileHit",
   "in": [{"from": "dp:AP:4", "to": "ax", "as": "mobj"}],
   "out": [{"native": "c", "upstream": "c", "bytes": 1}]},
  "p_mobj65.s:shr3": {
   "native": "shr3",
   "in": [{"from": "cx", "to": "zp:GA_0", "bytes": 4}],
   "out": [{"native": "zp:GA_0", "upstream": "cx", "bytes": 4}]},
  "p_mobj65.s:isPlayer": {
   "native": "p_mobj_isPlayer",
   "in": [{"from": "dp:AP:4", "to": "ax", "as": "mobj"}],
   "out": [{"native": "a", "upstream": "a", "bytes": 1}]}
 }
}
