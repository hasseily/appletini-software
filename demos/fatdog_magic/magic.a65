; FATDOG MAGIC: SYS entry $2000, runtime $A000-$BAFF.
; Images own MAIN/AUX $2000-$9FFF. Shared directory names $0900-$18FF,
; paths $1900-$19FF, directory/probe buffer $1D00-$1EFF, MLI buffer $BB00.
; Brooks palettes temporarily own MAIN/AUX $0400-$1CFF. Save names/paths
; in AUX $A500-$B5FF while a Brooks image is displayed; restore before UI/MLI OPEN.
!cpu 6502
* = $2000
    cld
    ldx #0
relocate:
    !for page, 0, 30 {
        lda $2000 + page * 256,x
        sta $A000 + page * 256,x
    }
    inx
    beq +
    jmp relocate
+
    jmp start

!pseudopc $A000 + (* - $2000) {
MLI = $BF00
KBD = $C000
STROBE = $C010
ptr = $06
SLIDE_FRAMES = 480

start:
    cld
    jsr main_bank
    jsr MLI
    !byte $CC
    !word close_all
    bcc +
    jmp fatal
+   lda #0
    ldx #23
-   sta $BF58,x
    dex
    bpl -
    lda #$CF                 ; zero page, stack, text page
    sta $BF58
    lda #1
    sta $BF6F                ; ProDOS global page
    sta $BFFD                ; SYS version byte
    lda #$FF
    ldx #3
-   sta $BF6C,x              ; code $A000-$BEFF + ProDOS global $BF00
    dex
    bpl -
    sta $BF59                ; shared names $0900-$0FFF (+ unused $0800)
    sta $BF5A                ; shared names $1000-$17FF
    lda #$F8
    sta $BF5B                ; reserve $1800-$1CFF; MLI buffers $1D00-$1EFF free
    lda #$E1
    sta $BF6F                ; code $B800-$BAFF + $BF00; OPEN claims $BB00-$BEFF
    lda #<quit
    sta $03F2
    lda #>quit
    sta $03F3
    eor #$A5
    sta $03F4
    jsr set_prefix
    bcc +
    jmp fatal
+   lda #0
    sta image_index
    sta paused
    sta use_vbl
    lda $FBB3                ; IIe/IIgs have a readable VBL signal
    cmp #$06
    bne +
    lda $FBC0                ; IIc needs a different VBL protocol: use delay
    beq +
    inc use_vbl
+   jmp folder_menu

load_image:
    jsr main_bank
    jsr restore_catalog
    jsr make_image_path
    jsr open_file
    lda open_ref
    sta read_ref
    sta close_ref
    sta mark_ref
    jsr load_picture
image_loaded:
image_ready:
    lda #2
    sta screen_state
    jsr reset_timer
wait_picture:
    bit KBD
    bmi handle_key
    jsr wait_frame
    lda paused
    bne wait_picture
    jsr countdown
    bne wait_picture
next_image:
    inc image_index
    lda image_index
    cmp image_count
    bcc +
    lda #0
    sta image_index
+   jmp load_image

handle_key:
    lda KBD
    and #$7F
    bit STROBE
    cmp #$1B
    bne +
    jmp folder_menu
+   cmp #$08
    beq previous_image
    cmp #$15
    beq next_image
    cmp #$0D
    beq next_image
    cmp #$20
    beq toggle_pause
    and #$DF
    cmp #'N'
    beq next_image
    cmp #'P'
    beq previous_image
    cmp #'R'
    beq first_image
    cmp #'H'
    beq help_key
    jmp wait_picture
previous_image:
    lda image_index
    bne +
    lda image_count
+   sec
    sbc #1
    sta image_index
    jmp load_image
first_image:
    lda #0
    sta image_index
    jmp load_image
toggle_pause:
    lda paused
    eor #1
    sta paused
    jmp image_ready
help_key:
    jsr help_screen
help_wait:
    bit KBD
    bpl help_wait
    lda KBD
    and #$7F
    bit STROBE
    cmp #$1B
    bne +
    jmp folder_menu
+   jmp load_image

main_bank:
    lda #0
    sta $C000               ; 80STORE off
    sta $C002               ; main reads
    sta $C004               ; main writes
    rts

reset_timer:
    lda #<SLIDE_FRAMES
    sta ticks
    lda #>SLIDE_FRAMES
    sta ticks+1
    rts
countdown:
    lda ticks
    bne +
    dec ticks+1
+   dec ticks
    lda ticks
    ora ticks+1
    rts

; Count a full low/high cycle, so IIe/IIgs VBL polarity is irrelevant.
; Bounded polling falls back to a 1 MHz delay if VBL never changes.
wait_frame:
    lda use_vbl
    beq delay_frame
    ldx #0
    ldy #0
-   bit $C019
    bpl vbl_low
    dex
    bne -
    dey
    bne -
    beq vbl_unavailable
vbl_low:
    ldx #0
    ldy #0
-   bit $C019
    bmi frame_done
    dex
    bne -
    dey
    bne -
vbl_unavailable:
    lda #0
    sta use_vbl
delay_frame:
    ldy #13
-   ldx #255
--  dex
    bne --
    dey
    bne -
frame_done:
    rts

; Always derive the volume prefix from the device that loaded this SYS.
set_prefix:
    lda $BF30
    sta online_unit
    jsr MLI
    !byte $C5
    !word online_params
    bcs prefix_done
    lda online_buffer
    and #$0F
    beq prefix_error
    tax
    clc
    adc #1
    sta prefix_buffer
    lda #'/'
    sta prefix_buffer+1
-   lda online_buffer,x
    sta prefix_buffer+1,x
    dex
    bne -
    jsr MLI
    !byte $C6
    !word prefix_params
prefix_done:
    rts
prefix_error:
    sec
    rts

fatal:
    jsr main_bank
    jsr capture_release      ; bounded cleanup: stop any temporary capture
    lda #5
    sta screen_state
    jsr select_hgr
    bit $C051
    bit $C054
    ldx #0
    lda #$A0
-   sta $0400,x
    sta $0500,x
    sta $0600,x
    sta $0700,x
    inx
    bne -
    ldx #error_end-error_text-1
-   lda error_text,x
    ora #$80
    sta $0400,x
    dex
    bpl -
    bit STROBE
-   bit KBD
    bpl -
quit:
    cld
    jsr select_hgr
    bit $C051
    bit $C054
    bit $C052
    bit STROBE
    jsr MLI
    !byte $CC
    !word close_all
    inc $03F4
    jsr MLI
    !byte $65
    !word quit_params
    jmp quit

image_index: !byte 0
paused: !byte 0
use_vbl: !byte 0
ticks: !word 0
error_text: !text "IMAGE LOAD ERROR. PRESS A KEY TO QUIT."
error_end:
open_params: !byte 3
open_path: !word 0
    !word $BB00              ; outside image pages and the low-RAM palettes
open_ref: !byte 0
read_params: !byte 4
read_ref: !byte 0
read_buffer: !word $2000
read_length: !word $2000
read_count: !word 0
close_params: !byte 1
close_ref: !byte 0
close_all: !byte 1,0
quit_params: !byte 4,0,0,0,0,0,0
online_params: !byte 2
online_unit: !byte 0
    !word online_buffer
online_buffer = $1E00       ; share the free directory buffer before scanning
prefix_params: !byte 1
    !word prefix_buffer
prefix_buffer = $1940

!source "formats.a65"
!source "palettes.a65"
!source "directories.a65"
!source "ui.a65"
}
!if * > $3B00 { !error "Viewer overlaps its MLI buffer at $BB00" }
