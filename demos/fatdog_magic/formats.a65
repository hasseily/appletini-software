; Bank layouts and video setup adapted from appletini-one/software/a2imgview.a65.
; No PAGE2 flipping: images replace the displayed memory in place.
; The A2Li mode and SHR extension magic are committed after their pixels.
FMT_SHR = 0
FMT_HGR = 1
FMT_HGRI = 2
FMT_DHGR = 3
FMT_DHGRI = 4
src_ptr = $14
dst_ptr = $16

load_picture:
    lda #0
    sta paged_mode
    sta $407C               ; stop old hires/lores paging before reusing RAM
    sta $087C
    lda image_kind
    cmp #$10
    bne +
    lda #FMT_HGR
    sta current_format
    jmp load_hgr
+   cmp #$20
    bne +
    ; 16K: A2Li in the second main page distinguishes HGRi/p from DHGR.
    lda #$20
    jsr probe_paged
    bcc ordinary_dhgr
    lda #FMT_HGRI
    sta current_format
    jmp load_hgri
ordinary_dhgr:
    lda #FMT_DHGR
    sta current_format
    jmp load_dhgr
+   cmp #$30
    bne shr_image
    ; 32K: second page's MAIN hole is in the fourth 8K chunk.
    lda #$60
    jsr probe_paged
    bcc shr_image
    lda #FMT_DHGRI
    sta current_format
    jmp load_dhgri
shr_image:
    lda #FMT_SHR
    sta current_format
    jmp load_shr

; Inspect file offset A:$78, then rewind. C=1 for a valid A2Li pair.
probe_paged:
    sta mark_position+1
    lda #$78
    sta mark_position
    lda #0
    sta mark_position+2
    jsr set_mark
    lda #<directory_buffer
    sta read_buffer
    lda #>directory_buffer
    sta read_buffer+1
    lda #5
    sta read_length
    lda #0
    sta read_length+1
    jsr read_exact
    lda #0
    sta probe_result
    ldx #3
-   lda directory_buffer,x
    cmp a2li_signature,x
    bne probe_done
    dex
    bpl -
    lda directory_buffer+4
    cmp #1
    beq +
    cmp #2
    bne probe_done
+   inc probe_result
probe_done:
    lda #0
    sta mark_position
    sta mark_position+1
    jsr set_mark
    lda probe_result
    lsr                     ; result bit 0 -> carry
    rts
set_mark:
    jsr MLI
    !byte $CE
    !word mark_params
    bcc +
    jmp fatal
+   rts

load_hgr:
    jsr select_hgr
    lda #$20
    ldy #$20
    jsr read_chunk
    jmp finish_legacy
load_hgri:
    jsr select_hgr
    lda #$20
    ldy #$20
    jsr read_chunk
    jsr read_main_page2
    jmp finish_legacy
load_dhgr:
    jsr select_dhgr
    jsr read_pair_page1
    jmp finish_legacy
load_dhgri:
    jsr select_dhgr
    jsr read_pair_page1
    lda #$60
    ldy #$20
    jsr read_chunk
    lda #$60
    ldx #$40
    ldy #$20
    jsr copy_to_aux
    jsr read_main_page2
finish_legacy:
    jsr close_file
    lda current_format
    cmp #FMT_DHGR
    bcs +
    jsr select_hgr
    jmp ++
+   jsr select_dhgr
++  lda paged_mode
    sta $407C               ; arm only after all banks/pages and switches are ready
    rts

read_pair_page1:
    ; AUX must be staged with main writes selected for all MLI calls.
    lda #$60
    ldy #$20
    jsr read_chunk
    lda #$60
    ldx #$20
    ldy #$20
    jsr copy_to_aux
    lda #$20
    ldy #$20
    jmp read_chunk

read_main_page2:
    lda #$60
    ldy #$20
    jsr read_chunk
    lda $607C
    sta paged_mode
    lda #0
    sta $607C               ; show the incoming page without arming a partial pair
    sta src_ptr
    sta dst_ptr
    lda #$60
    sta src_ptr+1
    lda #$40
    sta dst_ptr+1
    ldx #$20
-   ldy #0
--  lda (src_ptr),y
    sta (dst_ptr),y
    iny
    bne --
    inc src_ptr+1
    inc dst_ptr+1
    dex
    bne -
    rts

load_shr:
    ; Invalidate the preceding AUX extension before its pixels are replaced.
    jsr main_bank
    sta $C005
    lda #0
    ldx #7
-   sta $9DF8,x
    dex
    bpl -
    sta $C004
    lda #$20
    ldy #$80
    jsr read_chunk          ; first 32K -> MAIN staging $2000-$9FFF
    ldx #3
-   lda $9DFC,x
    sta shr_magic,x
    lda #0
    sta $9DFC,x
    dex
    bpl -
    ; Select SHR before the AUX copy so it paints in. Do not write $407C
    ; here: MAIN $2000-$9FFF now contains pixels destined for AUX.
    lda #$C1
    sta $C029
    lda #$20
    ldx #$20
    ldy #$80
    jsr copy_to_aux
    ; A single-field file must not inherit MAIN's staged control block.
    lda #0
    ldx #7
-   sta $9DF8,x
    dex
    bpl -
    lda image_kind
    cmp #$60
    bcs load_brooks_pair
    cmp #$30               ; 32K: no second payload
    beq shr_complete
    ldy #$19               ; 39168: 6400 bytes of Brooks line palettes
    cmp #$40
    beq +
    ldy #$80               ; 64K: second complete field in MAIN
+   lda #$20
    jsr read_chunk
shr_complete:
    jsr close_file
shr_publish:
    jsr main_bank
    sta $C005
    ldx #0
-   lda shr_magic,x
    sta $9DFC,x
    inx
    cpx #4
    bne -
    sta $C004
    rts

load_brooks_pair:
    ; File order: 32K AUX field, 6400 palette bytes, 32K MAIN field,
    ; then an optional second 6400-byte palette. AUX pixels are already loaded.
    jsr capture_detect       ; identify LINTXT before touching its I/O registers

    ; MAIN's second image has not been loaded yet, so its $2000 area is
    ; available to stage the first palette. ProDOS always runs with MAIN
    ; reads/writes and uses an I/O buffer at $BB00, outside palette RAM.
    lda #$20
    ldy #$19                 ; $19 pages * 256 = 6400 bytes
    jsr read_chunk

    lda #1                   ; CONFIG bit 0 = 1: watch AUX writes
    jsr capture_enable       ; ARM exactly AUX $0400-$1CFF; wait for BUSY=0
    lda #$20                 ; source = MAIN $2000
    ldx #$04                 ; destination = AUX $0400
    ldy #$19                 ; copy all 25 pages while the window is armed
    jsr copy_to_aux          ; CPU stores, so vTW posts every palette byte
    jsr capture_disable      ; OFF; wait until ARMED and FRAME_PENDING clear

    lda image_kind
    cmp #$70
    beq brooks_main_field    ; a separate second palette will be uploaded later
    lda #$20                 ; shared table: stage another copy for MAIN
    ldx #$A0                 ; AUX $A000-$B8FF, outside all active capture ranges
    ldy #$19
    jsr copy_to_aux          ; do NOT install MAIN yet: SmartPort uses $07F8

brooks_main_field:
    lda #$20
    ldy #$80                 ; second field: 32768 bytes -> MAIN $2000-$9FFF
    jsr read_chunk
    lda image_kind
    cmp #$70
    beq +                    ; 78336-byte exports append a distinct second table
    jmp brooks_close         ; shared table is already staged in AUX $A000
+   lda #$A0
    sta palette_page
    lda #$19
    sta palette_pages_left
-   lda #>directory_buffer   ; $1D00 staging is just OUTSIDE the capture window
    ldy #1
    jsr read_chunk            ; read 256 bytes without touching either image
    lda #>directory_buffer
    ldx palette_page
    ldy #1
    jsr copy_to_aux           ; stage separate MAIN table in AUX $A000-$B8FF
    inc palette_page
    dec palette_pages_left
    bne -
brooks_close:
    jsr close_file           ; LAST disk call: it may write MAIN $07F8
    jsr install_main_palette ; upload after CLOSE, preserving catalog by swapping
    jmp shr_publish          ; publish AUX magic; no more MLI until navigation

; A=source page, X=destination page, Y=page count. Code/data reads stay MAIN.
; Only zero-page loop state is written while RAMWRT selects AUX.
copy_to_aux:
    sta src_ptr+1
    stx dst_ptr+1
    sty copy_pages
    lda #0
    sta src_ptr
    sta dst_ptr
    jsr main_bank
    ldx copy_pages
    sta $C005
-   ldy #0
--  lda (src_ptr),y
    sta (dst_ptr),y
    iny
    bne --
    inc src_ptr+1
    inc dst_ptr+1
    dex
    bne -
    sta $C004
    rts

; Read Y*256 bytes into MAIN A:00. No MLI executes with auxiliary writes on.
read_chunk:
    sta read_buffer+1
    sty read_length+1
    lda #0
    sta read_buffer
    sta read_length
read_exact:
    jsr main_bank
    jsr MLI
    !byte $CA
    !word read_params
    bcs read_error
    lda read_count
    cmp read_length
    bne read_error
    lda read_count+1
    cmp read_length+1
    bne read_error
    rts
read_error:
    jmp fatal

select_hgr:
    jsr select_legacy
    jsr video7_normal
    bit $C05F
    sta $C00C               ; HGR / 40 columns
    rts
select_dhgr:
    jsr select_legacy
    sta $C07E               ; IIc IOUDIS gate, as in the demo viewer
    lda cur_video7
    bne video7_mix
    jmp video7_normal
select_legacy:
    jsr main_bank
    lda #0
    sta $407C
    sta $087C
    lda #$01
    sta $C029               ; leave SHR
    bit $C052               ; full-screen graphics
    bit $C054               ; always PAGE1
    bit $C057
    bit $C050
    rts
video7_normal:
    sta $C00D
    bit $C05E
    bit $C05F
    bit $C05E
    bit $C05F
    bit $C05E
    rts
video7_mix:
    sta $C00C
    bit $C05E
    bit $C05F
    sta $C00D
    bit $C05E
    bit $C05F
    bit $C05E
    rts

; Video-7 MIX is not encoded by A2Li. A folder ending .MIX selects the same
; five-access AN3 sequence used for the demo's FACE.I; other folders use normal.
folder_video7:
    lda #0
    sta cur_video7
    ldx folder_path
    ldy #3
-   lda folder_path,x
    cmp mix_suffix,y
    bne +
    dex
    dey
    bpl -
    lda #2
    sta cur_video7
+   rts

image_kind: !byte 0
current_format: !byte 0
cur_video7: !byte 0
paged_mode: !byte 0
probe_result: !byte 0
copy_pages: !byte 0
palette_page: !byte 0
palette_pages_left: !byte 0
shr_magic: !fill 4,0
a2li_signature: !byte $C1,$B2,$CC,$E9
mix_suffix: !text ".MIX"
mark_params: !byte 2
mark_ref: !byte 0
mark_position: !byte 0,0,0
